  "RULE_4_FAKE": "<font=\"EastSeaDokdo-Regular SDF\"><size=210%><color=#8B0000><rotate=0>4.<rotate=-8> <rotate=-40><size=230%>매<rotate=28><size=200%>시<rotate=-10> <rotate=42><color=#6B0000><size=210%>2<rotate=-32><size=225%>0<rotate=18><size=195%>분<rotate=-45><color=#8B0000>에<rotate=30>서<rotate=-12> <rotate=-26><color=#A00000><size=220%>4<rotate=44><size=205%>0<rotate=-38><color=#8B0000>분<rotate=12> <rotate=32><size=195%>동<rotate=-42><size=225%>안<rotate=22><size=210%><color=#6B0000>문<rotate=-30><color=#8B0000>을<rotate=8> <rotate=45><size=230%>열<rotate=-24><size=195%>어<rotate=38><color=#A00000><size=210%>두<rotate=-44><size=220%><color=#8B0000>세<rotate=20><size=205%>요<rotate=-34><size=230%>.</color></size></font>",
